# Copy this file to `.env` and fill in your own Supabase project values.
#   Supabase dashboard -> Project Settings -> API
#
# These are safe to expose in a browser bundle: the anon key only grants the
# permissions your Row Level Security policies allow, and the policies in
# supabase/schema.sql restrict every row to its owning user.
#
# Leave these blank and the app runs in local-only mode (localStorage, one device).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
