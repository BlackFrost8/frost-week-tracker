# Optional. The normal way to configure this app is to paste your Firebase
# config straight into src/lib/firebase-config.ts and commit it — these are
# public client identifiers, not secrets, and Firestore rules are what actually
# protect your data. See firestore.rules.
#
# These environment variables exist only as an override, e.g. to point a CI
# build at a separate staging project. They take precedence over the values in
# firebase-config.ts.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
